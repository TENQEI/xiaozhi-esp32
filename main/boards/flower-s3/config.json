{
    "type": "flower-s3",
    "target": "esp32s3",
    "builds": [
        {
            "name": "flower-s3",
            "sdkconfig_append": [
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_PM_ENABLE=y",
                "CONFIG_FREERTOS_USE_TICKLESS_IDLE=y"
            ]
        }
    ]
}
